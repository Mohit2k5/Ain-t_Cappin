# ==========================================
# Ain't Cappin — Root .gitignore
# ==========================================

# Environment variables & secrets (CRITICAL)
.env
*.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/.venv/
.venv/
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# AI Model Caches
.cache/
huggingface/
torch/

# Node & Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.local

# Logs
logs/
*.log

# Operating System & IDE
.DS_Store
Thumbs.db
desktop.ini
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
