# ==========================================
# Ain't Cappin — Frontend .gitignore
# ==========================================

# Environment variables & secrets
.env
.env.local
.env.*.local
*.env
!.env.example

# Dependencies
node_modules/

# Production build output
dist/
dist-ssr/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local overrides
*.local

# Editor directories and OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
